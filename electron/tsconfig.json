{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "esModuleInterop": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": "../dist/electron",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true
  },
  "include": ["main.cts", "preload.cts", "ipc-handlers.cts"]
}
